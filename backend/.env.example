# ============================================================
# Spotify Clone Backend — Environment Variables
# Copy to backend/.env and fill in real values
# ============================================================

# MongoDB
MONGODB_URI=mongodb+srv://spotifyclone:SpotifyApp_Secure2024!@spotifyclone.a9uqpkf.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=spotify_clone

# JWT
JWT_SECRET=changeme_replace_with_64_char_random_hex
JWT_EXPIRE_DAYS=7

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=872fff74d9adfedf4fd7e5d0a62a8778
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=spotify-clone-media
R2_ENDPOINT_URL=https://872fff74d9adfedf4fd7e5d0a62a8778.r2.cloudflarestorage.com

# CORS - allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Storage Provider
# "gridfs"  — Active: stores audio/covers in MongoDB GridFS (no extra billing)
# "r2"       — Future: stores in Cloudflare R2 (enable R2 in CF dashboard first)
# "local"    — Dev fallback: stores in uploads/ on local disk
STORAGE_PROVIDER=gridfs

# App
ENVIRONMENT=development
MAX_AUDIO_SIZE_MB=50
MAX_COVER_SIZE_MB=5
